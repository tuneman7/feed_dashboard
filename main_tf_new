# Application Load Balancer (public)
resource "aws_lb" "dmtdashboard" {
  name               = "dmtdashboard-alb"
  load_balancer_type = "application"
  security_groups    = [aws_security_group.alb.id]
  subnets            = data.aws_subnets.default.ids
  idle_timeout       = 60

  tags = { Name = "dmtdashboard-alb" }
}

# Target group for Streamlit (port 8501)
resource "aws_lb_target_group" "dmtdashboard_streamlit" {
  name        = "dmtdashboard-tg-8501"
  port        = 8501
  protocol    = "HTTP"
  vpc_id      = data.aws_vpc.rds_vpc.id
  target_type = "instance"

  health_check {
    path                = "/"
    healthy_threshold   = 2
    unhealthy_threshold = 2
    timeout             = 5
    interval            = 30
    matcher             = "200-399"
    port                = "traffic-port"
  }

  tags = { Name = "dmtdashboard-tg-8501" }
}

# Attach EC2 instance to 8501 target group
resource "aws_lb_target_group_attachment" "dmtdashboard_streamlit" {
  target_group_arn = aws_lb_target_group.dmtdashboard_streamlit.arn
  target_id        = aws_instance.ubuntu_box.id
  port             = 8501
}

# Listener on 443 (TLS via ACM) -> forward to Streamlit (8501)
resource "aws_lb_listener" "https" {
  load_balancer_arn = aws_lb.dmtdashboard.arn
  port              = 443
  protocol          = "HTTPS"
  ssl_policy        = "ELBSecurityPolicy-2016-08"
  certificate_arn   = aws_acm_certificate.dmtdashboard.arn

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.dmtdashboard_streamlit.arn
  }

  depends_on = [aws_acm_certificate_validation.dmtdashboard]
}

# Route53: apex A/ALIAS -> ALB
resource "aws_route53_record" "dmtdashboard_apex" {
  zone_id = data.aws_route53_zone.dmtdashboard.zone_id
  name    = "dmtdashboard.link"
  type    = "A"

  alias {
    name                   = aws_lb.dmtdashboard.dns_name
    zone_id                = aws_lb.dmtdashboard.zone_id
    evaluate_target_health = true
  }
}

# Optional: www -> apex
resource "aws_route53_record" "dmtdashboard_www" {
  zone_id = data.aws_route53_zone.dmtdashboard.zone_id
  name    = "www"
  type    = "CNAME"
  ttl     = 300
  records = ["dmtdashboard.link"]
}

# Extra outputs for the new components
output "alb_dns_name" {
  description = "Public DNS name of the ALB"
  value       = aws_lb.dmtdashboard.dns_name
}

output "domain_url" {
  description = "HTTPS URL for the site"
  value       = "https://dmtdashboard.link"
}
