<!-- Shift4 header (left aligned) -->
<div style="margin:0 0 12px 0; padding:0; text-align:left;">
  <img src="cid:shift4logo"
       alt="Shift4 Data Systems Team"
       width="600" height="130"
       style="display:inline-block; max-width:600px; height:auto; margin:0; padding:0; float:left; text-align:left;" />
</div>
<div style="clear:both;"></div>

<div style="font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial; line-height:1.5; color:#111;">
  <h3 style="margin:0 0 8px 0;">🚨 Pipeline <span style="color:#b00020;">Hard Failure</span></h3>
  <table style="border-collapse:collapse; width:100%; max-width:640px;">
    <tr><td style="padding:4px 8px;"><strong>Pipeline</strong></td><td style="padding:4px 8px;">{{ pipeline_name }}</td></tr>
    <tr><td style="padding:4px 8px;"><strong>Environment</strong></td><td style="padding:4px 8px;">{{ environment_cd }} ({{ environment_desc }})</td></tr>
    <tr><td style="padding:4px 8px;"><strong>Run ID</strong></td>   <td style="padding:4px 8px;">{{ pipeline_run_id }}</td></tr>
    <tr><td style="padding:4px 8px;"><strong>Start</strong></td>    <td style="padding:4px 8px;">{{ start_dt | fmt_dt }}</td></tr>
    <tr><td style="padding:4px 8px;"><strong>End</strong></td>      <td style="padding:4px 8px;">{{ end_dt | fmt_dt }}</td></tr>
    <tr><td style="padding:4px 8px;"><strong>Duration</strong></td> <td style="padding:4px 8px;">{{ duration_minutes }} min ({{ duration_seconds | hms }})</td></tr>
    {% if total_processed_count is not none %}
    <tr><td style="padding:4px 8px;"><strong>Total Rows (partial/failed)</strong></td><td style="padding:4px 8px;">{{ total_processed_count | comma }}</td></tr>
    {% endif %}

    {% if cloudwatch_log_url %}
    <tr>
    <td style="padding:4px 8px;"><strong>Logs</strong></td>
    <td style="padding:4px 8px;">
        <a href="{{ cloudwatch_log_url }}" target="_blank" rel="noopener noreferrer"
        style="color:#0073e6; text-decoration:underline;">
        Open CloudWatch Logs
        </a>
    </td>
    </tr>
    {% endif %}

    <tr><td style="padding:4px 8px;"><strong>Action Taken</strong></td>    <td style="padding:4px 8px;">Data Systems Team notified and pager duty alert tracking triggered.</td></tr>

    <tr><td style="padding:4px 8px;"><strong>Alert</strong></td>    <td style="padding:4px 8px;">{{ alert_name }}</td></tr>
    <tr><td style="padding:4px 8px;"><strong>Severity</strong></td> <td style="padding:4px 8px;">{{ severity_text }}</td></tr>
  </table>

  <p style="margin-top:16px; font-size:12px; color:#333;">This is an automated notification.</p>
</div>

